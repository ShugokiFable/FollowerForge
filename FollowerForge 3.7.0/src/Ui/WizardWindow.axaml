<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:FollowerForge.Ui"
        x:Class="FollowerForge.Ui.WizardWindow"
        Width="1320" Height="900" MinWidth="1040" MinHeight="700"
        WindowStartupLocation="CenterScreen"
        Icon="/Assets/appicon.ico"
        Title="FollowerForge 3.7.0"
        Background="{DynamicResource WindowBrush}"
        Foreground="{DynamicResource TextBrush}"
        KeyDown="OnWindowKeyDown"
        SizeChanged="OnWindowSizeChanged"
        Closing="OnWindowClosing">
  <Window.Styles>
    <Style Selector="TextBlock.h1"><Setter Property="FontSize" Value="28"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/><Setter Property="Margin" Value="0,0,0,2"/></Style>
    <Style Selector="TextBlock.h2"><Setter Property="FontSize" Value="18"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/></Style>
    <Style Selector="TextBlock.hint"><Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}"/><Setter Property="FontSize" Value="13"/><Setter Property="LineHeight" Value="19"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
    <Style Selector="TextBlock.label"><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/><Setter Property="Margin" Value="0,14,0,6"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
    <Style Selector="TextBlock.step"><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/><Setter Property="FontSize" Value="13"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
    <Style Selector="TextBlock.rowname"><Setter Property="FontSize" Value="14"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="TextTrimming" Value="CharacterEllipsis"/></Style>
    <Style Selector="TextBlock.rowdetail"><Setter Property="FontSize" Value="12.5"/><Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}"/><Setter Property="Margin" Value="0,3,0,0"/><Setter Property="TextTrimming" Value="CharacterEllipsis"/></Style>
    <Style Selector="Border.focus-card"><Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="12"/><Setter Property="Padding" Value="20"/></Style>
    <Style Selector="Border.studio-card"><Setter Property="Background" Value="{DynamicResource ElevatedSurfaceBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="12"/><Setter Property="Padding" Value="18"/></Style>
    <Style Selector="ListBox"><Setter Property="Background" Value="{DynamicResource WindowBrush}"/><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="8"/></Style>
    <Style Selector="ListBoxItem"><Setter Property="Padding" Value="14,10"/><Setter Property="MinHeight" Value="46"/></Style>
    <Style Selector="ListBoxItem:selected /template/ ContentPresenter"><Setter Property="Background" Value="{DynamicResource SelectionBrush}"/></Style>
    <Style Selector="TextBox"><Setter Property="Background" Value="{DynamicResource WindowBrush}"/><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/><Setter Property="CornerRadius" Value="8"/><Setter Property="Padding" Value="12,9"/><Setter Property="MinHeight" Value="38"/></Style>
    <!-- Default buttons/combo boxes draw from tokens too; the Fluent theme variant also follows
         the palette (ThemeResources.Apply), so no control is ever white-on-cream in Light. -->
    <Style Selector="Button"><Setter Property="Padding" Value="16,10"/><Setter Property="MinHeight" Value="38"/><Setter Property="CornerRadius" Value="8"/><Setter Property="Background" Value="{DynamicResource ElevatedSurfaceBrush}"/><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/><Setter Property="BorderThickness" Value="1"/></Style>
    <Style Selector="Button:pointerover"><Setter Property="Background" Value="{DynamicResource SelectionBrush}"/></Style>
    <Style Selector="Button:pressed"><Setter Property="Background" Value="{DynamicResource BorderBrush}"/></Style>
    <Style Selector="Button.primary"><Setter Property="Background" Value="{DynamicResource AccentBrush}"/><Setter Property="Foreground" Value="{DynamicResource OnStatusBrush}"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="BorderThickness" Value="0"/></Style>
    <Style Selector="Button.primary:pointerover"><Setter Property="Background" Value="{DynamicResource AccentHoverBrush}"/></Style>
    <Style Selector="Button.primary:pressed"><Setter Property="Background" Value="{DynamicResource AccentPressedBrush}"/></Style>
    <Style Selector="Button.nav"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="12,10"/></Style>
    <Style Selector="Button.nav:pointerover"><Setter Property="Background" Value="{DynamicResource SelectionBrush}"/></Style>
    <Style Selector="ComboBox"><Setter Property="MinHeight" Value="38"/><Setter Property="CornerRadius" Value="8"/><Setter Property="Background" Value="{DynamicResource WindowBrush}"/><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/><Setter Property="BorderThickness" Value="1"/></Style>
    <Style Selector="NumericUpDown"><Setter Property="MinHeight" Value="38"/></Style>
    <Style Selector="CheckBox"><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/><Setter Property="MinHeight" Value="38"/></Style>
    <Style Selector="Expander"><Setter Property="HorizontalAlignment" Value="Stretch"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="12"/><Setter Property="Padding" Value="14"/></Style>
    <Style Selector="DataGrid"><Setter Property="Background" Value="{DynamicResource WindowBrush}"/><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="8"/><Setter Property="GridLinesVisibility" Value="Horizontal"/></Style>
    <Style Selector="DataGridRow"><Setter Property="MinHeight" Value="40"/></Style>
    <!-- Badge chips: the row template switches these classes from IPickerRow.Chip* bindings, so a
         live theme switch repaints every visible chip. Tinted translucent fill + colored text
         (Raycast/Linear-style badges) — never solid blocks, never hardcoded brushes. -->
    <Style Selector="Border.chip-good"><Setter Property="Background" Value="{DynamicResource SuccessSoftBrush}"/></Style>
    <Style Selector="Border.chip-good TextBlock"><Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/></Style>
    <Style Selector="Border.chip-ok"><Setter Property="Background" Value="{DynamicResource InfoSoftBrush}"/></Style>
    <Style Selector="Border.chip-ok TextBlock"><Setter Property="Foreground" Value="{DynamicResource InfoBrush}"/></Style>
    <Style Selector="Border.chip-warn"><Setter Property="Background" Value="{DynamicResource WarningSoftBrush}"/></Style>
    <Style Selector="Border.chip-warn TextBlock"><Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/></Style>
    <Style Selector="Border.chip-bad"><Setter Property="Background" Value="{DynamicResource DangerSoftBrush}"/></Style>
    <Style Selector="Border.chip-bad TextBlock"><Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/></Style>
    <Style Selector="Border.chip-dim"><Setter Property="Background" Value="{DynamicResource ElevatedSurfaceBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/><Setter Property="BorderThickness" Value="1"/></Style>
    <Style Selector="Border.chip-dim TextBlock"><Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}"/></Style>
  </Window.Styles>
  <Window.DataTemplates>
    <DataTemplate DataType="ui:IPickerRow">
      <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
        <StackPanel Grid.Column="0"><TextBlock Classes="rowname" Text="{Binding Display}"/><TextBlock Classes="rowdetail" Text="{Binding Detail}" IsVisible="{Binding HasDetail}"/></StackPanel>
        <Border Grid.Column="1" IsVisible="{Binding HasBadge}"
                Classes.chip-good="{Binding ChipGood}" Classes.chip-ok="{Binding ChipOk}"
                Classes.chip-warn="{Binding ChipWarn}" Classes.chip-bad="{Binding ChipBad}"
                Classes.chip-dim="{Binding ChipDim}"
                CornerRadius="999" Padding="10,3" Margin="12,0,0,0" VerticalAlignment="Center"><TextBlock Text="{Binding Badge}" FontSize="11" FontWeight="SemiBold"/></Border>
      </Grid>
    </DataTemplate>
  </Window.DataTemplates>
  <Grid RowDefinitions="76,*,60">
    <Border Grid.Row="0" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="22,14">
      <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto" ColumnSpacing="12">
        <StackPanel><TextBlock Text="FOLLOWERFORGE" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/><TextBlock Text="CREATOR STUDIO 3.6" FontSize="10" Foreground="{DynamicResource MutedTextBrush}"/></StackPanel>
        <StackPanel Grid.Column="1"><TextBlock x:Name="TopFollowerName" Text="New follower" FontSize="17" FontWeight="SemiBold"/><TextBlock x:Name="AutosaveState" Text="● UI preferences saved" FontSize="11" Foreground="{DynamicResource SuccessBrush}"/></StackPanel>
        <Button Grid.Column="2" Content="⌕  Commands  Ctrl+K" Click="OnOpenCommandPalette"/>
        <Button Grid.Column="3" x:Name="ExperienceButton" Content="Guided" Click="OnToggleExperience"/>
        <ComboBox Grid.Column="4" x:Name="ThemeBox" Width="170" SelectionChanged="OnThemeChanged"><ComboBoxItem Content="Obsidian Gold"/><ComboBoxItem Content="Arcane Amethyst"/><ComboBoxItem Content="Nordic Frost"/><ComboBoxItem Content="Forge Teal"/><ComboBoxItem Content="Light"/></ComboBox>
        <Button Grid.Column="5" x:Name="DossierToggleButton" Content="Dossier" Click="OnOpenDossier" IsVisible="False"/>
      </Grid>
    </Border>
    <Grid Grid.Row="1" x:Name="WorkspaceGrid" ColumnDefinitions="256,*,312">
      <Border Grid.Column="0" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0" Padding="16">
        <DockPanel>
          <StackPanel DockPanel.Dock="Bottom" Spacing="6" Margin="0,12,0,0">
            <TextBlock x:Name="EnvLine" Classes="hint" FontSize="11.5" Text="Starting up…"/>
            <Button x:Name="ManagerSwitchButton" Content="Use Mod Organizer 2 instead" FontSize="11" IsVisible="True" Click="OnManagerSwitch"/>
            <Button x:Name="Mo2SetupButton" Content="MO2 setup…" FontSize="11" IsVisible="True" Click="OnMo2Setup"/>
            <Button x:Name="PathsSetupButton" Content="Paths…" FontSize="11" Click="OnPathsSetup"/>
          </StackPanel>
          <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="4">
              <TextBlock Text="WORKSPACE" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource MutedTextBrush}" Margin="8,4,0,8"/>
              <Button x:Name="NavButtonStudio" Classes="nav" Tag="0" Click="OnNavClicked"><TextBlock Text="⌂  Studio overview" FontWeight="SemiBold"/></Button>
              <Button Classes="nav" Tag="1" Click="OnNavClicked"><Grid RowDefinitions="Auto,Auto"><TextBlock x:Name="Step0" Classes="step" Text="Identity &amp; progression"/><Border x:Name="NavStatusPill0" Grid.Row="1" Classes="chip-bad" CornerRadius="999" Padding="8,2" HorizontalAlignment="Left" Margin="0,4,0,0"><TextBlock x:Name="NavStatus0" Text="Error" FontSize="10.5" FontWeight="SemiBold"/></Border></Grid></Button>
              <Button Classes="nav" Tag="2" Click="OnNavClicked"><Grid RowDefinitions="Auto,Auto"><TextBlock x:Name="Step1" Classes="step" Text="Appearance"/><Border x:Name="NavStatusPill1" Grid.Row="1" Classes="chip-ok" CornerRadius="999" Padding="8,2" HorizontalAlignment="Left" Margin="0,4,0,0"><TextBlock x:Name="NavStatus1" Text="In progress" FontSize="10.5" FontWeight="SemiBold"/></Border></Grid></Button>
              <Button Classes="nav" Tag="3" Click="OnNavClicked"><Grid RowDefinitions="Auto,Auto"><TextBlock x:Name="Step2" Classes="step" Text="Voice &amp; dialogue"/><Border x:Name="NavStatusPill2" Grid.Row="1" Classes="chip-warn" CornerRadius="999" Padding="8,2" HorizontalAlignment="Left" Margin="0,4,0,0"><TextBlock x:Name="NavStatus2" Text="Needs attention" FontSize="10.5" FontWeight="SemiBold"/></Border></Grid></Button>
              <Button Classes="nav" Tag="4" Click="OnNavClicked"><Grid RowDefinitions="Auto,Auto"><TextBlock x:Name="Step3" Classes="step" Text="Combat, skills &amp; transformation"/><Border x:Name="NavStatusPill3" Grid.Row="1" Classes="chip-warn" CornerRadius="999" Padding="8,2" HorizontalAlignment="Left" Margin="0,4,0,0"><TextBlock x:Name="NavStatus3" Text="Needs attention" FontSize="10.5" FontWeight="SemiBold"/></Border></Grid></Button>
              <Button Classes="nav" Tag="5" Click="OnNavClicked"><Grid RowDefinitions="Auto,Auto"><TextBlock x:Name="Step4" Classes="step" Text="Loadout"/><Border x:Name="NavStatusPill4" Grid.Row="1" Classes="chip-dim" CornerRadius="999" Padding="8,2" HorizontalAlignment="Left" Margin="0,4,0,0"><TextBlock x:Name="NavStatus4" Text="Optional" FontSize="10.5" FontWeight="SemiBold"/></Border></Grid></Button>
              <Button Classes="nav" Tag="6" Click="OnNavClicked"><Grid RowDefinitions="Auto,Auto"><TextBlock x:Name="Step5" Classes="step" Text="Placement &amp; routines"/><Border x:Name="NavStatusPill5" Grid.Row="1" Classes="chip-warn" CornerRadius="999" Padding="8,2" HorizontalAlignment="Left" Margin="0,4,0,0"><TextBlock x:Name="NavStatus5" Text="Needs attention" FontSize="10.5" FontWeight="SemiBold"/></Border></Grid></Button>
              <Button Classes="nav" Tag="7" Click="OnNavClicked"><Grid RowDefinitions="Auto,Auto"><TextBlock x:Name="Step6" Classes="step" Text="Review, validation &amp; build"/><Border x:Name="NavStatusPill6" Grid.Row="1" Classes="chip-warn" CornerRadius="999" Padding="8,2" HorizontalAlignment="Left" Margin="0,4,0,0"><TextBlock x:Name="NavStatus6" Text="Needs attention" FontSize="10.5" FontWeight="SemiBold"/></Border></Grid></Button>
            </StackPanel>
          </ScrollViewer>
        </DockPanel>
      </Border>
      <Grid Grid.Column="1" x:Name="CategoryHost" Margin="28,24">
        <ScrollViewer x:Name="StudioPage" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
          <StackPanel Spacing="20">
            <StackPanel Spacing="4"><TextBlock Classes="h1" Text="Follower Studio"/><TextBlock Classes="hint" Text="One draft, seven clear categories, and the next useful action always visible."/></StackPanel>
            <Border Classes="focus-card" BorderBrush="{DynamicResource AccentBrush}"><Grid ColumnDefinitions="*,Auto" ColumnSpacing="16"><StackPanel><TextBlock Text="NEXT RECOMMENDED ACTION" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/><TextBlock x:Name="NextActionTitle" Text="Give the follower a name" FontSize="20" FontWeight="SemiBold" Margin="0,6,0,0"/><TextBlock x:Name="NextActionDetail" Classes="hint" Text="Identity is the only required starting point." Margin="0,4,0,0"/></StackPanel><Button Grid.Column="1" x:Name="NextActionButton" Classes="primary" Content="Open category" Click="OnNextRecommended" VerticalAlignment="Center"/></Grid></Border>
            <WrapPanel ItemWidth="300">
              <Border Classes="studio-card" Width="300" Margin="0,0,14,14"><StackPanel><TextBlock Text="Identity &amp; progression" Classes="h2"/><TextBlock x:Name="StudioSummary0" Classes="hint" Text="Name, protection, relationship and level."/><Button Tag="1" Content="Open identity" Click="OnNavClicked" HorizontalAlignment="Left" Margin="0,12,0,0"/></StackPanel></Border>
              <Border Classes="studio-card" Width="300" Margin="0,0,14,14"><StackPanel><TextBlock Text="Appearance" Classes="h2"/><TextBlock x:Name="StudioSummary1" Classes="hint" Text="Race, face, vampire state and body."/><Button Tag="2" Content="Open appearance" Click="OnNavClicked" HorizontalAlignment="Left" Margin="0,12,0,0"/></StackPanel></Border>
              <Border Classes="studio-card" Width="300" Margin="0,0,14,14"><StackPanel><TextBlock Text="Voice &amp; dialogue" Classes="h2"/><TextBlock x:Name="StudioSummary2" Classes="hint" Text="Voice coverage and custom spoken lines."/><Button Tag="3" Content="Open voice" Click="OnNavClicked" HorizontalAlignment="Left" Margin="0,12,0,0"/></StackPanel></Border>
              <Border Classes="studio-card" Width="300" Margin="0,0,14,14"><StackPanel><TextBlock Text="Combat &amp; skills" Classes="h2"/><TextBlock x:Name="StudioSummary3" Classes="hint" Text="Class, style, stats and transformation."/><Button Tag="4" Content="Open combat" Click="OnNavClicked" HorizontalAlignment="Left" Margin="0,12,0,0"/></StackPanel></Border>
              <Border Classes="studio-card" Width="300" Margin="0,0,14,14"><StackPanel><TextBlock Text="Loadout" Classes="h2"/><TextBlock x:Name="StudioSummary4" Classes="hint" Text="Armor, weapons, ammo, belongings and magic."/><Button Tag="5" Content="Open loadout" Click="OnNavClicked" HorizontalAlignment="Left" Margin="0,12,0,0"/></StackPanel></Border>
              <Border Classes="studio-card" Width="300" Margin="0,0,14,14"><StackPanel><TextBlock Text="Placement &amp; routines" Classes="h2"/><TextBlock x:Name="StudioSummary5" Classes="hint" Text="Starting place, routine and alternate spawns."/><Button Tag="6" Content="Open placement" Click="OnNavClicked" HorizontalAlignment="Left" Margin="0,12,0,0"/></StackPanel></Border>
              <Border Classes="studio-card" Width="300" Margin="0,0,14,14"><StackPanel><TextBlock Text="Review &amp; build" Classes="h2"/><TextBlock x:Name="StudioSummary6" Classes="hint" Text="Dossier, validation, destination and build."/><Button Tag="7" Content="Open review" Click="OnNavClicked" HorizontalAlignment="Left" Margin="0,12,0,0"/></StackPanel></Border>
            </WrapPanel>
            <Border Classes="focus-card"><StackPanel><TextBlock Text="ENVIRONMENT" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/><TextBlock x:Name="EnvironmentState" Text="Starting environment discovery…" FontSize="17" FontWeight="SemiBold"/><TextBlock x:Name="StudioEnvironmentDetail" Classes="hint" Text="Manager, catalogue, xVASynth and output state will appear here."/></StackPanel></Border>
          </StackPanel>
        </ScrollViewer>
        <ScrollViewer x:Name="Page0" IsVisible="False" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
          <StackPanel Spacing="18">
            <TextBlock x:Name="Page0Title" Classes="h1" Text="Identity &amp; progression"/>
            <TextBlock Classes="hint" Text="A name is enough to start. Defaults remain safe and reversible."/>
            <Border Classes="focus-card"><StackPanel>
              <TextBlock Classes="h2" Text="Who are you creating?"/>
              <TextBlock Classes="label" Text="Name"/><TextBox x:Name="NameBox" PlaceholderText="e.g. Aria" KeyUp="OnNameTyped"/>
              <TextBlock Classes="label" Text="Plugin"/><TextBox x:Name="PluginBox" IsReadOnly="True"/>
              <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                <StackPanel><TextBlock Classes="label" Text="Sex"/><ComboBox x:Name="SexBox" SelectedIndex="0" SelectionChanged="OnSexChanged"><ComboBoxItem>Female</ComboBoxItem><ComboBoxItem>Male</ComboBoxItem></ComboBox></StackPanel>
                <StackPanel Grid.Column="1"><TextBlock Classes="label" Text="Mortality"/><ComboBox x:Name="MortalBox" SelectedIndex="0"><ComboBoxItem>Protected</ComboBoxItem><ComboBoxItem>Essential</ComboBoxItem><ComboBoxItem>Mortal</ComboBoxItem></ComboBox></StackPanel>
              </Grid>
              <CheckBox x:Name="MarriageBox" Margin="0,8,0,0" Content="Marriageable"/>
              <TextBlock x:Name="RegardsYouLabel" Classes="label" Text="How she regards you"/>
              <ComboBox x:Name="RelationshipBox" SelectedIndex="1"><ComboBoxItem>Rival</ComboBoxItem><ComboBoxItem>Friend</ComboBoxItem><ComboBoxItem>Confidant</ComboBoxItem><ComboBoxItem>Ally</ComboBoxItem><ComboBoxItem>Lover</ComboBoxItem></ComboBox>
            </StackPanel></Border>
            <Expander Header="Advanced progression" IsExpanded="False"><StackPanel Margin="0,10,0,0">
              <TextBlock Classes="label" Text="Level behavior"/><ComboBox x:Name="LevelModeBox" SelectedIndex="0"><ComboBoxItem>Scales with player</ComboBoxItem><ComboBoxItem>Fixed level</ComboBoxItem></ComboBox>
              <Grid ColumnDefinitions="*,*,*" ColumnSpacing="12">
                <StackPanel><TextBlock Classes="label" Text="Minimum"/><NumericUpDown x:Name="MinLevelBox" MinWidth="150" Minimum="1" Maximum="32767" Value="10"/></StackPanel>
                <StackPanel Grid.Column="1"><TextBlock Classes="label" Text="Maximum (0 = none)"/><NumericUpDown x:Name="MaxLevelBox" MinWidth="150" Minimum="0" Maximum="32767" Value="0"/></StackPanel>
                <StackPanel Grid.Column="2"><TextBlock Classes="label" Text="Fixed"/><NumericUpDown x:Name="FixedLevelBox" MinWidth="150" Minimum="1" Maximum="32767" Value="20"/></StackPanel>
              </Grid>
            </StackPanel></Expander>
            <Expander Header="Relationships with existing NPCs" IsExpanded="False"><StackPanel Margin="0,10,0,0">
              <TextBlock x:Name="KinSectionLabel" Classes="label" Text="How she regards other people"/><TextBlock x:Name="KinHintText" Classes="hint"/>
              <Grid ColumnDefinitions="*,170,90" ColumnSpacing="8" Margin="0,10,0,0"><TextBox x:Name="KinSearch" PlaceholderText="Search NPCs by name…" KeyUp="OnKinSearch"/><ComboBox Grid.Column="1" x:Name="KinRankBox" SelectedIndex="3"><ComboBoxItem>Rival</ComboBoxItem><ComboBoxItem>Friend</ComboBoxItem><ComboBoxItem>Confidant</ComboBoxItem><ComboBoxItem>Ally</ComboBoxItem><ComboBoxItem>Lover</ComboBoxItem></ComboBox><Button Grid.Column="2" x:Name="AddKinButton" Content="Add" Click="OnAddKin"/></Grid>
              <ListBox x:Name="KinCandidates" MaxHeight="320" Margin="0,10,0,0"/><TextBlock x:Name="KinError" Foreground="{DynamicResource DangerBrush}" IsVisible="False"/>
              <TextBlock x:Name="KinPeopleLabel" Classes="label" Text="Her people"/><ListBox x:Name="KinList" MaxHeight="400"/><Button Content="Remove selected" Click="OnRemoveKin" HorizontalAlignment="Left" Margin="0,10,0,0"/>
            </StackPanel></Expander>
          </StackPanel>
        </ScrollViewer>
        <ScrollViewer x:Name="Page1" IsVisible="False" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
          <StackPanel Spacing="18">
            <TextBlock x:Name="Page1Title" Classes="h1" Text="Appearance"/><TextBlock x:Name="Page1Hint" Classes="hint"/>
            <Border Classes="focus-card"><StackPanel><TextBlock Classes="h2" Text="RaceMenu face"/><TextBox x:Name="FaceSearch" PlaceholderText="Search exported faces…" KeyUp="OnFaceSearch" Margin="0,10,0,0"/><ListBox x:Name="FaceList" MaxHeight="400" Margin="0,10,0,0" SelectionChanged="OnFaceSelected"/><StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Left" Margin="0,10,0,0"><Button Tag="Face" Content="Browse full face catalogue" Click="OnOpenDeck"/><Button Tag="Face" Content="Clear" Click="OnClearPicks" ToolTip.Tip="Unselect everything in this list."/></StackPanel></StackPanel></Border>
            <Border Classes="focus-card"><StackPanel><TextBlock Classes="h2" Text="Race and condition"/><CheckBox x:Name="VampireBox" Content="She is a vampire"/><CheckBox x:Name="CustomRacesBox" Content="Include custom playable races" IsCheckedChanged="OnCustomRacesToggled"/><CheckBox x:Name="CreatureRacesBox" Content="Include creature races" IsCheckedChanged="OnCustomRacesToggled"/><TextBox x:Name="RaceSearch" PlaceholderText="Search races…" KeyUp="OnRaceSearch" Margin="0,10,0,0"/><ListBox x:Name="RaceList" MaxHeight="420" Margin="0,10,0,0"/><Button Tag="Race" Content="Browse full race catalogue" Click="OnOpenDeck" HorizontalAlignment="Left" Margin="0,10,0,0"/></StackPanel></Border>
          </StackPanel>
        </ScrollViewer>
        <ScrollViewer x:Name="Page2" IsVisible="False" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
          <StackPanel Spacing="18">
            <TextBlock x:Name="Page2Title" Classes="h1" Text="Voice &amp; dialogue"/><TextBlock Classes="hint" Text="Follower-ready voices are ranked first; custom lines remain optional."/>
            <Expander Header="Voice choice" IsExpanded="True"><StackPanel Margin="0,10,0,0">
              <Grid ColumnDefinitions="*,240" ColumnSpacing="10"><TextBox x:Name="VoiceSearch" PlaceholderText="Search voices…" KeyUp="OnVoiceSearch"/><ComboBox Grid.Column="1" x:Name="VoiceScopeBox" SelectedIndex="0" SelectionChanged="OnVoiceScopeChanged"><ComboBoxItem Content="Voices she can actually use"/><ComboBoxItem Content="Every voice, including creatures"/></ComboBox></Grid>
              <TextBlock x:Name="VoiceCountLine" Classes="hint" Margin="0,8,0,0"/><ListBox x:Name="VoiceList" MaxHeight="420" Margin="0,10,0,0" SelectionChanged="OnVoiceSelected"/><Button Tag="Voice" Content="Browse full voice catalogue" Click="OnOpenDeck" HorizontalAlignment="Left" Margin="0,10,0,0"/>
            </StackPanel></Expander>
            <Expander Header="Custom spoken lines" IsExpanded="False"><StackPanel Margin="0,10,0,0">
              <TextBlock x:Name="CustomLinesHint" Classes="hint"/><TextBlock x:Name="VoiceSynthStatus" Classes="hint" Text="Checking xVASynth…"/>
              <Grid ColumnDefinitions="180,*" ColumnSpacing="8" Margin="0,10,0,0"><ComboBox x:Name="LineTriggerBox" SelectedIndex="0" SelectionChanged="OnLineTriggerChanged"><ComboBoxItem>When you talk to her</ComboBoxItem><ComboBoxItem>As you walk away</ComboBoxItem><ComboBoxItem>Idle chatter</ComboBoxItem><ComboBoxItem>A topic you can pick</ComboBoxItem><ComboBoxItem>A fight starts</ComboBoxItem><ComboBoxItem>The fight is over</ComboBoxItem><ComboBoxItem>Taunting an enemy</ComboBoxItem><ComboBoxItem>Swinging a weapon</ComboBoxItem><ComboBoxItem>Power attack</ComboBoxItem><ComboBoxItem>Blocking a blow</ComboBoxItem><ComboBoxItem>Taking a hit</ComboBoxItem><ComboBoxItem>Going down</ComboBoxItem><ComboBoxItem>Dying</ComboBoxItem></ComboBox><TextBox Grid.Column="1" x:Name="LinePromptBox" IsVisible="False" PlaceholderText="Menu entry the player clicks"/></Grid>
              <Grid ColumnDefinitions="*,160,110" ColumnSpacing="8" Margin="0,10,0,0"><TextBox x:Name="LineTextBox" PlaceholderText="What she says…"/><ComboBox Grid.Column="1" x:Name="LineEmotionBox" SelectedIndex="0"><ComboBoxItem>Neutral</ComboBoxItem><ComboBoxItem>Anger</ComboBoxItem><ComboBoxItem>Disgust</ComboBoxItem><ComboBoxItem>Fear</ComboBoxItem><ComboBoxItem>Sad</ComboBoxItem><ComboBoxItem>Happy</ComboBoxItem><ComboBoxItem>Surprise</ComboBoxItem><ComboBoxItem>Puzzled</ComboBoxItem></ComboBox><Button Grid.Column="2" x:Name="AddLineButton" Content="Add line" Click="OnAddLine"/></Grid>
              <Grid ColumnDefinitions="*,170" ColumnSpacing="8" Margin="0,10,0,0"><ComboBox x:Name="LinePlaceBox" SelectedIndex="0"/><ComboBox Grid.Column="1" x:Name="LineTimeBox" SelectedIndex="0"><ComboBoxItem>Any time</ComboBoxItem><ComboBoxItem>Daytime</ComboBoxItem><ComboBoxItem>At night</ComboBoxItem></ComboBox></Grid>
              <TextBlock x:Name="LineError" Foreground="{DynamicResource DangerBrush}" IsVisible="False"/><TextBlock x:Name="HerLinesLabel" Classes="label" Text="Her lines"/><ListBox x:Name="LineList" MaxHeight="360"/>
              <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,10,0,0"><Button Content="Remove selected" Click="OnRemoveLine"/><CheckBox x:Name="SynthesizeBox" IsChecked="True" Content="Speak them out loud (needs xVASynth)"/></StackPanel>
            </StackPanel></Expander>
          </StackPanel>
        </ScrollViewer>
        <ScrollViewer x:Name="Page3" IsVisible="False" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
          <StackPanel Spacing="18">
            <TextBlock x:Name="Page3Title" Classes="h1" Text="Combat, skills &amp; transformation"/><TextBlock Classes="hint" Text="Start with class and style; advanced growth and transformation stay deliberate."/>
            <Expander Header="Class, combat style and temper" IsExpanded="True"><StackPanel Margin="0,10,0,0">
              <TextBox x:Name="ClassSearch" PlaceholderText="Search classes…" KeyUp="OnClassSearch"/><ListBox x:Name="ClassList" MaxHeight="340" Margin="0,10,0,0"/><Button Tag="Class" Content="Browse full class catalogue" Click="OnOpenDeck" HorizontalAlignment="Left" Margin="0,10,0,0"/>
              <TextBox x:Name="CstySearch" PlaceholderText="Search combat styles…" KeyUp="OnCstySearch" Margin="0,14,0,0"/><ListBox x:Name="CstyList" MaxHeight="340" Margin="0,10,0,0"/><StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Left" Margin="0,10,0,0"><Button Tag="CombatStyle" Content="Browse full combat-style catalogue" Click="OnOpenDeck"/><Button Tag="CombatStyle" Content="Clear" Click="OnClearPicks" ToolTip.Tip="Unselect everything in this list."/></StackPanel>
              <CheckBox x:Name="CloneCstyBox" Content="Copy the style into her plugin" Margin="0,10,0,0"/><TextBlock Classes="label" Text="Temper"/><ComboBox x:Name="TemperBox" SelectedIndex="3"><ComboBoxItem>Cowardly</ComboBoxItem><ComboBoxItem>Cautious</ComboBoxItem><ComboBoxItem>Average</ComboBoxItem><ComboBoxItem>Brave</ComboBoxItem><ComboBoxItem>Foolhardy</ComboBoxItem></ComboBox><TextBlock x:Name="TemperHint" Classes="hint"/>
            </StackPanel></Expander>
            <Expander Header="Skills and stats" IsExpanded="False"><StackPanel Margin="0,10,0,0">
              <TextBlock Classes="label" Text="Stat calculation"/><ComboBox x:Name="StatsModeBox" SelectedIndex="0" SelectionChanged="OnStatsModeChanged"><ComboBoxItem>Automatic - class and level calculate everything (recommended)</ComboBoxItem><ComboBoxItem>Custom - use exact values</ComboBoxItem></ComboBox>
              <StackPanel x:Name="CustomStatsPanel" IsVisible="False" Margin="0,12,0,0"><Grid ColumnDefinitions="*,Auto" ColumnSpacing="10"><ComboBox x:Name="StatPresetBox" SelectedIndex="0"><ComboBoxItem>Blank slate</ComboBoxItem><ComboBoxItem>One-handed warrior</ComboBoxItem><ComboBoxItem>Two-handed warrior</ComboBoxItem><ComboBoxItem>Archer</ComboBoxItem><ComboBoxItem>Pure mage</ComboBoxItem><ComboBoxItem>Spellsword</ComboBoxItem><ComboBoxItem>Restoration support</ComboBoxItem><ComboBoxItem>Rogue</ComboBoxItem></ComboBox><Button Grid.Column="1" Content="Apply preset" Click="OnApplyStatPreset"/></Grid><Grid ColumnDefinitions="*,*,*" ColumnSpacing="12" Margin="0,12,0,0"><StackPanel><TextBlock Text="Health"/><NumericUpDown x:Name="HealthStatBox" MinWidth="150" Minimum="0" Maximum="65535" Value="100"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="Magicka"/><NumericUpDown x:Name="MagickaStatBox" MinWidth="150" Minimum="0" Maximum="65535" Value="100"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Stamina"/><NumericUpDown x:Name="StaminaStatBox" MinWidth="150" Minimum="0" Maximum="65535" Value="100"/></StackPanel></Grid><Grid x:Name="SkillEditorGrid" ColumnDefinitions="*,*,*" ColumnSpacing="18" Margin="0,14,0,0"/></StackPanel>
            </StackPanel></Expander>
            <Expander Header="Experimental evolution" IsExpanded="False"><StackPanel Margin="0,10,0,0"><TextBlock x:Name="EvolveTitle" Classes="h2" Text="Let her grow"/><TextBlock x:Name="EvolveHint" Classes="hint"/><CheckBox x:Name="EvolveBox" Content="Let her evolve as she fights" IsCheckedChanged="OnEvolveToggled"/><Grid x:Name="EvolveOptions" IsEnabled="False" ColumnDefinitions="Auto,150,Auto,150,Auto,180" ColumnSpacing="8"><TextBlock Text="Phases" VerticalAlignment="Center"/><NumericUpDown Grid.Column="1" x:Name="EvolvePhases" MinWidth="140" Minimum="1" Maximum="10" Value="3"/><TextBlock Grid.Column="2" Text="Fights each" VerticalAlignment="Center"/><NumericUpDown Grid.Column="3" x:Name="EvolveCombats" MinWidth="140" Minimum="1" Maximum="100" Value="10"/><TextBlock Grid.Column="4" Text="Ends at" VerticalAlignment="Center"/><ComboBox Grid.Column="5" x:Name="EvolveEndBox" SelectedIndex="3"><ComboBoxItem>Cautious</ComboBoxItem><ComboBoxItem>Average</ComboBoxItem><ComboBoxItem>Brave</ComboBoxItem><ComboBoxItem>Foolhardy</ComboBoxItem></ComboBox></Grid><TextBlock x:Name="EvolveNote" Classes="hint"/></StackPanel></Expander>
            <Expander Header="Combat transformation" IsExpanded="False"><StackPanel Margin="0,10,0,0"><TextBlock x:Name="TransformHint" Classes="hint"/><ComboBox x:Name="TransformKindBox" SelectedIndex="0" SelectionChanged="OnTransformKindChanged"><ComboBoxItem>None</ComboBoxItem><ComboBoxItem>Werewolf</ComboBoxItem><ComboBoxItem>Custom race / spell</ComboBoxItem></ComboBox><Grid x:Name="TransformCustom" IsVisible="False" ColumnDefinitions="*,*" ColumnSpacing="12"><StackPanel><TextBox x:Name="TransformRaceSearch" PlaceholderText="Search transform races…" KeyUp="OnTransformRaceSearch"/><ListBox x:Name="TransformRaceList" MaxHeight="300"/><StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Left" Margin="0,8,0,0"><Button Tag="TransformRace" Content="Browse races" Click="OnOpenDeck"/><Button Tag="TransformRace" Content="Clear" Click="OnClearPicks" ToolTip.Tip="Unselect everything in this list."/></StackPanel></StackPanel><StackPanel Grid.Column="1"><TextBox x:Name="TransformSpellSearch" PlaceholderText="Search transform spells…" KeyUp="OnTransformSpellSearch"/><ListBox x:Name="TransformSpellList" MaxHeight="300"/><StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Left" Margin="0,8,0,0"><Button Tag="TransformSpell" Content="Browse spells" Click="OnOpenDeck"/><Button Tag="TransformSpell" Content="Clear" Click="OnClearPicks" ToolTip.Tip="Unselect everything in this list."/></StackPanel></StackPanel></Grid><CheckBox x:Name="TransformRevertBox" IsChecked="True" Content="Change back when the fight ends" Margin="0,4,0,0"/></StackPanel></Expander>
          </StackPanel>
        </ScrollViewer>
        <ScrollViewer x:Name="Page4" IsVisible="False" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
          <StackPanel Spacing="18">
            <TextBlock x:Name="Page4Title" Classes="h1" Text="Loadout"/><TextBlock x:Name="Page4Hint" Classes="hint"/>
            <Expander Header="Armor and accessories" IsExpanded="True"><StackPanel Margin="0,10,0,0">
              <TextBox x:Name="ArmorSearch" PlaceholderText="Search name, FormID or plugin…" KeyUp="OnArmorSearch"/>
              <Grid ColumnDefinitions="*,*" ColumnSpacing="12" Margin="0,10,0,0"><StackPanel><TextBlock Text="Torso"/><ListBox x:Name="ArmorTorsoList" MaxHeight="320" SelectionMode="Multiple" SelectionChanged="OnArmorSelectionChanged" Margin="0,6,0,0"/><StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Left" Margin="0,8,0,0"><Button Tag="ArmorTorso" Content="Browse torso" Click="OnOpenDeck"/><Button Tag="ArmorTorso" Content="Clear" Click="OnClearPicks" ToolTip.Tip="Unselect everything in this list."/></StackPanel></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="Helmet"/><ListBox x:Name="ArmorHeadList" MaxHeight="320" SelectionMode="Multiple" SelectionChanged="OnArmorSelectionChanged" Margin="0,6,0,0"/><StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Left" Margin="0,8,0,0"><Button Tag="ArmorHead" Content="Browse helmets" Click="OnOpenDeck"/><Button Tag="ArmorHead" Content="Clear" Click="OnClearPicks" ToolTip.Tip="Unselect everything in this list."/></StackPanel></StackPanel></Grid>
              <Expander Header="More armor slots" IsExpanded="False" Margin="0,12,0,0"><StackPanel Margin="0,10,0,0" Spacing="10">
                <TextBlock Text="Gauntlets"/><ListBox x:Name="ArmorHandsList" MaxHeight="280" SelectionMode="Multiple" SelectionChanged="OnArmorSelectionChanged"/><StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Left"><Button Tag="ArmorHands" Content="Browse gauntlets" Click="OnOpenDeck"/><Button Tag="ArmorHands" Content="Clear" Click="OnClearPicks" ToolTip.Tip="Unselect everything in this list."/></StackPanel>
                <TextBlock Text="Boots"/><ListBox x:Name="ArmorFeetList" MaxHeight="280" SelectionMode="Multiple" SelectionChanged="OnArmorSelectionChanged"/><StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Left"><Button Tag="ArmorFeet" Content="Browse boots" Click="OnOpenDeck"/><Button Tag="ArmorFeet" Content="Clear" Click="OnClearPicks" ToolTip.Tip="Unselect everything in this list."/></StackPanel>
                <TextBlock Text="Shields"/><ListBox x:Name="ArmorShieldList" MaxHeight="280" SelectionMode="Multiple" SelectionChanged="OnArmorSelectionChanged"/><StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Left"><Button Tag="ArmorShield" Content="Browse shields" Click="OnOpenDeck"/><Button Tag="ArmorShield" Content="Clear" Click="OnClearPicks" ToolTip.Tip="Unselect everything in this list."/></StackPanel>
                <TextBlock Text="Accessories"/><ListBox x:Name="ArmorAccessoriesList" MaxHeight="280" SelectionMode="Multiple" SelectionChanged="OnArmorSelectionChanged"/><StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Left"><Button Tag="ArmorAccessories" Content="Browse accessories" Click="OnOpenDeck"/><Button Tag="ArmorAccessories" Content="Clear" Click="OnClearPicks" ToolTip.Tip="Unselect everything in this list."/></StackPanel>
                <TextBlock Text="Other"/><ListBox x:Name="ArmorOtherList" MaxHeight="280" SelectionMode="Multiple" SelectionChanged="OnArmorSelectionChanged"/><StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Left"><Button Tag="ArmorOther" Content="Browse other armor" Click="OnOpenDeck"/><Button Tag="ArmorOther" Content="Clear" Click="OnClearPicks" ToolTip.Tip="Unselect everything in this list."/></StackPanel>
              </StackPanel></Expander>
            </StackPanel></Expander>
            <Expander Header="Weapons and ammunition" IsExpanded="False"><StackPanel Margin="0,10,0,0">
              <TextBox x:Name="WeaponSearch" PlaceholderText="Search weapons…" KeyUp="OnWeaponSearch"/><ListBox x:Name="WeaponList" MaxHeight="380" SelectionMode="Multiple" SelectionChanged="OnWeaponSelectionChanged" Margin="0,10,0,0"/><StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Left" Margin="0,10,0,0"><Button Tag="Weapon" Content="Browse full weapon catalogue" Click="OnOpenDeck"/><Button Tag="Weapon" Content="Clear" Click="OnClearPicks" ToolTip.Tip="Unselect everything in this list."/></StackPanel>
              <TextBlock x:Name="AmmoHint" Classes="hint" Margin="0,14,0,0"/><NumericUpDown x:Name="AmmoCountBox" Value="100" Minimum="1" Maximum="9999" Width="140" HorizontalAlignment="Left" Margin="0,6,0,0"/><TextBox x:Name="AmmoSearch" PlaceholderText="Search arrows and bolts…" KeyUp="OnAmmoSearch" Margin="0,6,0,0"/><ListBox x:Name="AmmoList" MaxHeight="360" SelectionMode="Multiple" SelectionChanged="OnAmmoSelectionChanged" Margin="0,10,0,0"/><StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Left" Margin="0,10,0,0"><Button Tag="Ammo" Content="Browse full ammunition catalogue" Click="OnOpenDeck"/><Button Tag="Ammo" Content="Clear" Click="OnClearPicks" ToolTip.Tip="Unselect everything in this list."/></StackPanel>
            </StackPanel></Expander>
            <Expander Header="Books and belongings" IsExpanded="False"><StackPanel Margin="0,10,0,0">
              <TextBlock x:Name="LoreHint" Classes="hint"/><Grid ColumnDefinitions="260,160,*" ColumnSpacing="8" Margin="0,6,0,0"><ComboBox x:Name="LoreKindBox" SelectedIndex="0" SelectionChanged="OnLoreKindChanged"><ComboBoxItem>Books and notes</ComboBoxItem><ComboBoxItem>Miscellaneous items</ComboBoxItem><ComboBoxItem>Food, potions and poisons</ComboBoxItem><ComboBoxItem>Ingredients</ComboBoxItem></ComboBox><NumericUpDown Grid.Column="1" x:Name="LoreCountBox" MinWidth="140" Value="1" Minimum="1" Maximum="9999"/><TextBox Grid.Column="2" x:Name="LoreSearch" PlaceholderText="Search belongings…" KeyUp="OnLoreSearch"/></Grid><ListBox x:Name="LoreList" MaxHeight="400" SelectionMode="Multiple" SelectionChanged="OnLoreSelectionChanged" Margin="0,10,0,0"/><StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Left" Margin="0,10,0,0"><Button Tag="Lore" Content="Browse full belongings catalogue" Click="OnOpenDeck"/><Button Tag="Lore" Content="Clear" Click="OnClearPicks" ToolTip.Tip="Unselect everything in this list."/></StackPanel>
            </StackPanel></Expander>
            <Expander Header="Spells and perks" IsExpanded="False"><Grid ColumnDefinitions="*,*" ColumnSpacing="12" Margin="0,10,0,0">
              <StackPanel><TextBlock x:Name="SpellsLabel" Classes="label" Text="Spells she knows"/><TextBox x:Name="SpellSearch" PlaceholderText="Search spells…" KeyUp="OnSpellSearch"/><ListBox x:Name="SpellList" MaxHeight="400" SelectionMode="Multiple" SelectionChanged="OnSpellSelectionChanged" Margin="0,10,0,0"/><StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Left" Margin="0,10,0,0"><Button Tag="Spell" Content="Browse spells" Click="OnOpenDeck"/><Button Tag="Spell" Content="Clear" Click="OnClearPicks" ToolTip.Tip="Unselect everything in this list."/></StackPanel></StackPanel>
              <StackPanel Grid.Column="1"><TextBlock x:Name="PerksLabel" Classes="label" Text="Perks she has"/><TextBox x:Name="PerkSearch" PlaceholderText="Search perks…" KeyUp="OnPerkSearch"/><ListBox x:Name="PerkList" MaxHeight="400" SelectionMode="Multiple" SelectionChanged="OnPerkSelectionChanged" Margin="0,10,0,0"/><StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Left" Margin="0,10,0,0"><Button Tag="Perk" Content="Browse perks" Click="OnOpenDeck"/><Button Tag="Perk" Content="Clear" Click="OnClearPicks" ToolTip.Tip="Unselect everything in this list."/></StackPanel></StackPanel>
            </Grid></Expander>
            <Expander Header="Legacy outfit and body" IsExpanded="False"><StackPanel Margin="0,10,0,0">
              <TextBox x:Name="OutfitSearch" PlaceholderText="Search legacy outfit records…" KeyUp="OnOutfitSearch"/><ListBox x:Name="OutfitList" MaxHeight="340" Margin="0,10,0,0"/><StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Left" Margin="0,10,0,0"><Button Tag="Outfit" Content="Browse outfits" Click="OnOpenDeck"/><Button Tag="Outfit" Content="Clear" Click="OnClearPicks" ToolTip.Tip="Unselect everything in this list."/></StackPanel>
              <TextBlock x:Name="BodyHint" Classes="hint" Margin="0,14,0,0"/><TextBox x:Name="SkinSearch" PlaceholderText="Search body / skin records…" KeyUp="OnSkinSearch" Margin="0,6,0,0"/><ListBox x:Name="SkinList" MaxHeight="340" Margin="0,10,0,0"/><StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Left" Margin="0,10,0,0"><Button Tag="Skin" Content="Browse body records" Click="OnOpenDeck"/><Button Tag="Skin" Content="Clear" Click="OnClearPicks" ToolTip.Tip="Unselect everything in this list."/></StackPanel>
            </StackPanel></Expander>
          </StackPanel>
        </ScrollViewer>
        <ScrollViewer x:Name="Page5" IsVisible="False" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
          <StackPanel Spacing="18">
            <TextBlock x:Name="Page5Title" Classes="h1" Text="Placement &amp; routines"/><TextBlock Classes="hint" Text="Choose a proven starting place, then refine routine and optional alternate starts."/>
            <Border Classes="focus-card"><StackPanel><TextBlock Classes="h2" Text="Starting location"/><TextBox x:Name="PlaceSearch" PlaceholderText="Search places…" KeyUp="OnPlaceSearch" Margin="0,4,0,0"/><ListBox x:Name="PlaceList" MaxHeight="440" Margin="0,10,0,0"/><Button Tag="Location" Content="Browse full location catalogue" Click="OnOpenDeck" HorizontalAlignment="Left" Margin="0,10,0,0"/></StackPanel></Border>
            <Expander Header="Daily routine" IsExpanded="True"><StackPanel Margin="0,10,0,0"><TextBlock x:Name="IdleLabel" Classes="label" Text="What she does while she waits"/><ComboBox x:Name="IdleBox" SelectedIndex="2"><ComboBoxItem>Leave it to the game</ComboBoxItem><ComboBoxItem>Keeps to her spot</ComboBoxItem><ComboBoxItem>Uses the room she is in</ComboBoxItem><ComboBoxItem>Settles wherever she is</ComboBoxItem></ComboBox><CheckBox x:Name="SleepsBox" IsChecked="True" Content="Goes to bed at night" Margin="0,4,0,0"/></StackPanel></Expander>
            <Expander Header="Alternate starts and enemy-to-ally" IsExpanded="False"><StackPanel Margin="0,10,0,0">
              <TextBlock x:Name="AlternateLabel" Classes="label"/><TextBlock x:Name="AlternateHint" Classes="hint"/><StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0"><Button Content="Add selected place" Click="OnAddAlternateSpawn"/><Button Content="Remove selected" Click="OnRemoveAlternateSpawn"/></StackPanel><TextBlock x:Name="SpawnError" Foreground="{DynamicResource DangerBrush}" IsVisible="False"/><ListBox x:Name="AlternateSpawnList" MaxHeight="240" Margin="0,10,0,0"/>
              <TextBlock x:Name="E2AHint" Classes="hint" Margin="0,12,0,0"/><CheckBox x:Name="E2ABox" IsChecked="False" Content="She must be defeated before recruitment" IsCheckedChanged="OnE2AToggled"/><StackPanel x:Name="E2AOptions" IsVisible="False" Orientation="Horizontal" Spacing="10" Margin="0,4,0,0"><TextBlock Text="Fights alongside" VerticalAlignment="Center"/><ComboBox x:Name="E2ACompanyBox" Width="260" SelectedIndex="0"><ComboBoxItem>Bandits</ComboBoxItem><ComboBoxItem>Draugr</ComboBoxItem><ComboBoxItem>Warlocks</ComboBoxItem><ComboBoxItem>Beasts and creatures</ComboBoxItem></ComboBox></StackPanel><TextBlock x:Name="E2ANote" Classes="hint"/>
            </StackPanel></Expander>
          </StackPanel>
        </ScrollViewer>
        <ScrollViewer x:Name="Page6" IsVisible="False" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
          <StackPanel Spacing="18">
            <TextBlock x:Name="Page6Title" Classes="h1" Text="Review, validation &amp; build"/>
            <Border Classes="focus-card"><StackPanel><TextBlock Classes="h2" Text="Complete dossier"/><TextBlock x:Name="SummaryText" Classes="hint" FontFamily="Cascadia Mono,Consolas,monospace" Margin="0,6,0,0"/></StackPanel></Border>
            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="12"><Border Classes="focus-card"><StackPanel><TextBlock Text="MUST FIX" FontWeight="Bold" Foreground="{DynamicResource DangerBrush}"/><ItemsControl x:Name="MustFixList" Margin="0,6,0,0"/></StackPanel></Border><Border Grid.Column="1" Classes="focus-card"><StackPanel><TextBlock Text="CHECK BEFORE BUILDING" FontWeight="Bold" Foreground="{DynamicResource WarningBrush}"/><ItemsControl x:Name="WarningList" Margin="0,6,0,0"/></StackPanel></Border><Border Grid.Column="2" Classes="focus-card"><StackPanel><TextBlock Text="INFORMATION" FontWeight="Bold" Foreground="{DynamicResource MutedTextBrush}"/><ItemsControl x:Name="InformationList" Margin="0,6,0,0"/></StackPanel></Border></Grid>
            <Border Classes="focus-card"><StackPanel>
              <TextBlock x:Name="AssetsLabel" Classes="label" Text="Appearance assets"/><ComboBox x:Name="HubModeBox" SelectedIndex="0" SelectionChanged="OnHubModeChanged"><ComboBoxItem>Keep matching textures from installed mods</ComboBoxItem><ComboBoxItem>Use safe free-resource substitutions</ComboBoxItem><ComboBoxItem>Copy assets into my own hub</ComboBoxItem></ComboBox>
              <StackPanel x:Name="OwnHubPanel" IsVisible="False" Margin="0,4,0,0"><TextBox x:Name="HubPrefixBox" Width="260" HorizontalAlignment="Left" PlaceholderText="Hub name"/><CheckBox x:Name="HubPermissionBox" Content="I checked each source mod's redistribution permissions." Margin="0,4,0,0"/></StackPanel>
              <!-- Wraps, not clips: these pages disable horizontal scrolling, so a fourth button
                   on a 1040px-wide window would otherwise be cut off with no way to reach it. -->
              <WrapPanel Orientation="Horizontal" ItemSpacing="12" LineSpacing="8" Margin="0,6,0,0"><Button x:Name="BuildButton" Classes="primary" Content="Build follower" Click="OnBuild"/><CheckBox x:Name="ZipBox" Content="Also make an installable .zip" IsChecked="True"/><Button x:Name="OpenFolderButton" Content="Open output folder" Click="OnOpenFolder" IsEnabled="False"/><Button x:Name="CopyDiagnosticsButton" Content="Copy diagnostics" Click="OnCopyDiagnostics" ToolTip.Tip="Copies your setup, what you picked, and the last build's findings to the clipboard. Paste it into a bug report. Home folders are replaced with %USERPROFILE% so your Windows account name is not published."/></WrapPanel>
              <TextBox x:Name="BuildLog" AcceptsReturn="True" IsReadOnly="True" MinHeight="240" FontFamily="Cascadia Mono,Consolas,monospace" TextWrapping="Wrap" Margin="0,8,0,0"/>
            </StackPanel></Border>
          </StackPanel>
        </ScrollViewer>
      </Grid>
      <Border Grid.Column="2" x:Name="DossierPanel" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1,0,0,0" Padding="20">
        <ScrollViewer><StackPanel Spacing="12"><TextBlock Text="FOLLOWER DOSSIER" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/><TextBlock x:Name="DossierName" Text="Unnamed follower" FontSize="20" FontWeight="SemiBold"/><TextBlock x:Name="DossierPlugin" Classes="hint" Text="No plugin name yet"/><Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,4,0,0"/><TextBlock x:Name="DossierIdentity" Classes="hint" Text="Identity not set"/><TextBlock x:Name="DossierAppearance" Classes="hint" Text="Appearance not set"/><TextBlock x:Name="DossierVoice" Classes="hint" Text="Voice not set"/><TextBlock x:Name="DossierCombat" Classes="hint" Text="Combat not set"/><TextBlock x:Name="DossierLoadout" Classes="hint" Text="Loadout optional"/><TextBlock x:Name="DossierPlacement" Classes="hint" Text="Placement fallback: Whiterun"/><Button Tag="7" Content="Review full dossier" Click="OnNavClicked" Margin="0,6,0,0"/></StackPanel></ScrollViewer>
      </Border>
    </Grid>
    <Border Grid.Row="2" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="22,12">
      <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12"><Button x:Name="BackButton" Content="Back" Click="OnBack"/><TextBlock Grid.Column="1" x:Name="StatusLine" Classes="hint" VerticalAlignment="Center" Text="Starting…"/><Button Grid.Column="2" x:Name="NextButton" Classes="primary" Content="Continue" Click="OnNext"/></Grid>
    </Border>
    <Border Grid.RowSpan="3" x:Name="DossierDrawer" IsVisible="False" HorizontalAlignment="Right" Width="340" Background="{DynamicResource ElevatedSurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1,0,0,0" Padding="24">
      <StackPanel><Button Content="Close dossier" Click="OnCloseDossier" HorizontalAlignment="Right"/><TextBlock Text="FOLLOWER DOSSIER" Classes="h2" Margin="0,18,0,0"/><TextBlock x:Name="DossierDrawerText" Classes="hint" Margin="0,10,0,0"/></StackPanel>
    </Border>
    <Border Grid.RowSpan="3" x:Name="CommandPaletteOverlay" IsVisible="False" Background="{DynamicResource OverlayBrush}">
      <Border Width="680" MaxHeight="540" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,96,0,0" Classes="focus-card" Background="{DynamicResource ElevatedSurfaceBrush}">
        <StackPanel><Grid ColumnDefinitions="*,Auto" ColumnSpacing="8"><TextBox x:Name="CommandSearch" PlaceholderText="Navigate or run a command…" KeyUp="OnCommandSearch"/><Button Grid.Column="1" Content="Close" Click="OnCloseCommandPalette"/></Grid><ListBox x:Name="CommandList" Margin="0,12,0,0" MinHeight="280" DoubleTapped="OnCommandInvoked"/></StackPanel>
      </Border>
    </Border>
    <Border Grid.RowSpan="3" x:Name="DeckOverlay" IsVisible="False" Background="{DynamicResource OverlayBrush}" Padding="32">
      <Border Background="{DynamicResource ElevatedSurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="14" Padding="22">
        <Grid RowDefinitions="Auto,*,Auto" ColumnDefinitions="190,*,280" RowSpacing="14" ColumnSpacing="16">
          <StackPanel Grid.Row="0" Grid.ColumnSpan="3"><Grid ColumnDefinitions="*,Auto"><StackPanel><TextBlock Text="EXPERT DECK" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/><TextBlock x:Name="DeckTitle" Classes="h1" Text="Catalogue"/></StackPanel><Button Grid.Column="1" Content="Cancel" Click="OnCancelDeck"/></Grid><TextBox x:Name="DeckSearch" PlaceholderText="Search name, EditorID, FormID or plugin…" KeyUp="OnDeckSearch" Margin="0,12,0,0"/></StackPanel>
          <StackPanel Grid.Row="1" Grid.Column="0"><TextBlock Text="RECORD FAMILY" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource MutedTextBrush}"/><TextBlock x:Name="DeckFamily" Text="Records" Margin="0,4,0,0"/><TextBlock x:Name="DeckSelectedCount" Classes="hint" Text="0 selected" Margin="0,6,0,0"/><Button Content="Clear filters" Click="OnClearDeckFilter" Margin="0,14,0,0" HorizontalAlignment="Left"/><Button Content="Clear selection" Click="OnClearDeckSelection" Margin="0,8,0,0" HorizontalAlignment="Left" ToolTip.Tip="Empties the selection cart. Nothing is applied until you press Apply selection."/></StackPanel>
          <Grid Grid.Row="1" Grid.Column="1" RowDefinitions="*,Auto"><DataGrid x:Name="DeckGrid" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Extended" SelectionChanged="OnDeckSelectionChanged"><DataGrid.Columns><DataGridCheckBoxColumn Header="In cart" Binding="{ReflectionBinding IsSelected}" Width="76" IsReadOnly="True"/><DataGridTextColumn Header="Name" Binding="{ReflectionBinding Display}" Width="2*"/><DataGridTextColumn Header="Plugin" Binding="{ReflectionBinding Plugin}" Width="*"/><DataGridTextColumn Header="FormID" Binding="{ReflectionBinding Key}" Width="1.5*"/><DataGridTextColumn Header="EditorID" Binding="{ReflectionBinding EditorId}" Width="1.5*"/></DataGrid.Columns></DataGrid><TextBlock Grid.Row="1" x:Name="DeckEmptyState" Classes="hint" IsVisible="False" Margin="0,8,0,0"/></Grid>
          <StackPanel Grid.Row="1" Grid.Column="2"><TextBlock Text="INSPECTOR" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource MutedTextBrush}"/><TextBlock x:Name="DeckInspectorName" Classes="h2" Text="Select a record" Margin="0,4,0,0"/><TextBlock x:Name="DeckInspectorType" Foreground="{DynamicResource AccentBrush}" Margin="0,2,0,0"/><TextBlock x:Name="DeckInspectorDetail" Classes="hint" Margin="0,8,0,0"/><TextBlock Text="SELECTION CART" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource MutedTextBrush}" Margin="0,18,0,6"/><ListBox x:Name="DeckCart" MinHeight="200"/></StackPanel>
          <Grid Grid.Row="2" Grid.ColumnSpan="3" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10"><TextBlock x:Name="DeckReturnHint" Classes="hint" VerticalAlignment="Center" Text="Click a row to select it. Ctrl+click adds or removes one; the checkbox is a status light, not a button."/><Button Grid.Column="1" Content="Cancel" Click="OnCancelDeck"/><Button Grid.Column="2" Classes="primary" Content="Apply selection" Click="OnApplyDeck"/></Grid>
        </Grid>
      </Border>
    </Border>
  </Grid>
</Window>
