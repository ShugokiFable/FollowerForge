<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\BuildPipeline\FollowerForge.BuildPipeline.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.0" />
    <PackageReference Include="Avalonia.Controls.DataGrid" Version="12.1.0" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.0" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.0" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!-- Shown by Windows on the .exe, in Explorer and on the taskbar. -->
    <ApplicationIcon>Assets\appicon.ico</ApplicationIcon>
    <AssemblyName>Follower Forge</AssemblyName>
    <RootNamespace>FollowerForge.Ui</RootNamespace>
    <Product>Follower Forge</Product>
    <AssemblyTitle>Follower Forge</AssemblyTitle>
    <Description>Make a custom Skyrim follower without the Creation Kit.</Description>
    <Company>Follower Forge</Company>
    <Version>3.1.1</Version>
    <FileVersion>3.1.1.0</FileVersion>
    <InformationalVersion>3.1.1</InformationalVersion>
    <Copyright>Follower Forge contributors</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

</Project>
