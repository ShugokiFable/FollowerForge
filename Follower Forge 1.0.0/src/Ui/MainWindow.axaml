<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="clr-namespace:FollowerForge.Domain;assembly=FollowerForge.Domain"
        x:Class="FollowerForge.Ui.MainWindow"
        Width="960" Height="680"
        Title="Follower Forge"
        Background="#1e1e24">
  <DockPanel Margin="12">
    <TextBlock DockPanel.Dock="Top" Text="Follower Forge" FontSize="22" FontWeight="Bold"
               Foreground="#c8a24b" Margin="0,0,0,8"/>
    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
      <Button x:Name="DiscoverButton" Content="Discover environment" Click="OnDiscover"/>
      <TextBlock x:Name="EnvSummary" VerticalAlignment="Center" Foreground="#ddd"
                 Text="Not discovered yet."/>
    </StackPanel>

    <TabControl>
      <TabItem Header="Catalogue">
        <DockPanel Margin="6">
          <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
            <ComboBox x:Name="TypeBox" Width="160" SelectedIndex="0">
              <ComboBoxItem>CombatStyle</ComboBoxItem>
              <ComboBoxItem>Race</ComboBoxItem>
              <ComboBoxItem>VoiceType</ComboBoxItem>
              <ComboBoxItem>Npc</ComboBoxItem>
              <ComboBoxItem>Outfit</ComboBoxItem>
              <ComboBoxItem>Class</ComboBoxItem>
            </ComboBox>
            <TextBox x:Name="SearchText" Width="260" Watermark="text filter (optional)"/>
            <Button Content="Index modpack" Click="OnIndex"/>
            <Button Content="Search" Click="OnSearch"/>
          </StackPanel>
          <DataGrid x:Name="ResultsGrid" IsReadOnly="True" AutoGenerateColumns="False"
                    GridLinesVisibility="Horizontal" x:DataType="d:IndexedRecord">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="110"/>
              <DataGridTextColumn Header="EditorID" Binding="{Binding EditorId}" Width="220"/>
              <DataGridTextColumn Header="Name" Binding="{Binding DisplayName}" Width="160"/>
              <DataGridTextColumn Header="FormKey" Binding="{Binding FormKey}" Width="200"/>
              <DataGridTextColumn Header="Winning" Binding="{Binding WinningPlugin}" Width="180"/>
            </DataGrid.Columns>
          </DataGrid>
        </DockPanel>
      </TabItem>

      <TabItem Header="Build follower">
        <DockPanel Margin="6">
          <StackPanel DockPanel.Dock="Top" Spacing="6" Margin="0,0,0,8">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBox x:Name="ProfilePath" Width="520" Watermark="path to follower-profile.json"/>
              <Button Content="Sample profile…" Click="OnSampleProfile"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBox x:Name="FaceName" Width="240" Watermark="CharGen export name (optional)"/>
              <CheckBox x:Name="ZipBox" Content="Zip package"/>
              <CheckBox x:Name="DetBox" Content="Verify deterministic"/>
              <Button x:Name="BuildButton" Content="Build" Click="OnBuild"/>
            </StackPanel>
          </StackPanel>
          <TextBox x:Name="BuildLog" AcceptsReturn="True" IsReadOnly="True"
                   FontFamily="Cascadia Mono,Consolas,monospace" Background="#15151a" Foreground="#cfe"/>
        </DockPanel>
      </TabItem>

      <TabItem Header="Detect">
        <DockPanel Margin="6">
          <Button DockPanel.Dock="Top" Content="Detect frameworks + body systems" Click="OnDetect"
                  HorizontalAlignment="Left" Margin="0,0,0,8"/>
          <TextBox x:Name="DetectLog" AcceptsReturn="True" IsReadOnly="True"
                   FontFamily="Cascadia Mono,Consolas,monospace" Background="#15151a" Foreground="#cfe"/>
        </DockPanel>
      </TabItem>
    </TabControl>
  </DockPanel>
</Window>
